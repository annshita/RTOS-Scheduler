# Port the server listens on (default: 3000)
PORT=3000

# Absolute path to the compiled rtsched binary.
# In Docker this is set automatically to /usr/local/bin/rtsched.
# For local dev outside Docker, point to your cmake build output:
#   BINARY_PATH=../build/rtsched      (Linux/macOS)
#   BINARY_PATH=../build/rtsched.exe  (Windows)
BINARY_PATH=../build/rtsched
